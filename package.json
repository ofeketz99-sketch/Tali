{
  "name": "tali",
  "version": "7.6.0",
  "productName": "Tali",
  "description": "Tali: אפליקציית הערות אישית. אובסידיאן פוגש וורד",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --sourcemap --log-level=warning",
    "start": "npm run build && electron .",
    "watch": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --sourcemap --watch",
    "test": "node --test tests/archive.test.mjs tests/hotkeys.test.mjs tests/launcher-update.test.mjs tests/list-direction.test.mjs tests/new-note-folder.test.mjs tests/overlay-data.test.mjs tests/overlay-geometry.test.mjs tests/release-manifest.test.mjs tests/stroke-smoothing.test.mjs tests/task-layout.test.mjs tests/theme-core.test.mjs tests/vault-data.test.mjs",
    "check": "node --check main.js && node --check preload.js && node --check links.js && node --check vault-data.js && node --check new-note-folder.js && node --check launcher/index.js && node --check launcher/update-core.js && node --check launcher/updater.js && node --check launcher/update-on-close.js && node --check tools/make-exe.js && node --check tools/release-manifest.js && npm run build && npm test",
    "splash:emblem": "electron tools/splash-render/main.js -- emblem",
    "splash:preview": "electron tools/splash-render/main.js -- preview",
    "splash:render": "electron tools/splash-render/main.js -- video src/splash.webm 48",
    "roundtrip": "electron tools/roundtrip/main.js --",
    "make-exe": "node tools/make-exe.js",
    "dist": "npx --yes electron-builder@25.1.8 --win --x64 --publish never",
    "release:manifest": "node tools/release-manifest.js release",
    "site:notes": "node tools/site-notes.js"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-color": "^2.11.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-bullet-list": "^2.11.0",
    "@tiptap/extension-ordered-list": "^2.11.0",
    "@tiptap/extension-table": "^2.11.0",
    "@tiptap/extension-table-cell": "^2.11.0",
    "@tiptap/extension-table-header": "^2.11.0",
    "@tiptap/extension-table-row": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-text-align": "^2.11.0",
    "@tiptap/extension-text-style": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "docx": "^9.15.3",
    "katex": "^0.16.22",
    "perfect-freehand": "1.2.3",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "lucide": "^0.577.0",
    "rcedit": "^4.0.1",
    "three": "^0.187.0",
    "webm-muxer": "^5.1.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  },
  "build": {
    "appId": "app.tali.notes",
    "productName": "Tali",
    "directories": {
      "output": "release"
    },
    "publish": [{
      "provider": "github",
      "owner": "ofeketz99-sketch",
      "repo": "Tali"
    }],
    "files": [
      "main.js",
      "preload.js",
      "links.js",
      "vault-data.js",
      "new-note-folder.js",
      "CHANGELOG.md",
      "package.json",
      "src/**/*",
      "!src/splash.webm",
      "!src/splash-preview.html",
      "dist/renderer.js",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Tali-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tali-${version}-portable.exe"
    }
  }
}

